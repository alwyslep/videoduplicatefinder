<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window on launch. CLI test modes (selftest 등) re-attach the parent
         console in Main so their output still shows when run from a terminal. -->
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VDF.Photino</RootNamespace>
    <AssemblyName>VDF.Photino</AssemblyName>
    <!-- Photino ships a native WebView2 loader; pin the RID so the native dll copies for dotnet run -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <!-- PerMonitorV2 DPI awareness at process load — fixes the intermittent 960×613 window size -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Release output goes straight to the flat "installed" folder the user runs from
       (C:\Users\geech\dev2\jav\dedup\VDF_Photino) instead of bin\Release\net10.0\win-x64.
       Debug keeps the conventional bin\ path so dev builds never clobber the app in use. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>..\..\VDF_Photino\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VDF.Core\VDF.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
